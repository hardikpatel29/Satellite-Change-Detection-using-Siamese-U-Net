# ==========================================
# Git Ignore — Satellite Change Detection
# ==========================================

# --- Large Datasets & Archives ---
# GitHub rejects files > 100 MB; never commit dataset ZIPs.
*.zip
*.tar
*.tar.gz
*.7z
*.rar
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Model Checkpoints & Weights ---
*.pth
*.pt
*.ckpt
*.h5
*.bin
*.onnx
models/*
!models/.gitkeep

# --- Generated Results & Prediction Outputs ---
# Auto-generated by src/evaluate.py; too large and noisy for version control.
results/predictions/*
!results/predictions/.gitkeep

# --- Private / Local-Only Scripts ---
generate_interview_doc.py
*.docx

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS Artifacts ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs & Temp ---
*.log
scratch/
tmp/
temp/

